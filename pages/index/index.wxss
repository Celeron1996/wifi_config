/**index.wxss**/
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.input {
	border-style : solid;
	border-color : rgb(189, 15, 15);
	border-width : 3rpx;
	font-size : x-large;
	font-weight : bold;
	font-style : normal;
	font-variant : normal;
}